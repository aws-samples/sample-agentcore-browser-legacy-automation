[MASTER]
init-hook='import sys; sys.path.append("src")'

[MESSAGES CONTROL]
disable=C0111,  # missing-docstring
        C0103,  # invalid-name
        R0913,  # too-many-arguments
        R0914,  # too-many-locals
        W0212,  # protected-access
        C0302,  # too-many-lines
        W0511   # fixme (allow TODO comments)

[FORMAT]
max-line-length=120
indent-string='    '

[DESIGN]
max-attributes=10
max-args=8
