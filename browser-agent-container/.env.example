# ==============================================
# BROWSER AGENT CONTAINER - ENVIRONMENT TEMPLATE
# ==============================================
# Copy this file to `.env` and fill in values for local development.
# `.env` is gitignored; `.env.example` is the tracked template.
#
# All browser-agent-specific vars use BA_ prefix (Browser Agent).
# Feature flags default to 'false' if unset.
# ==============================================

# ==============================================
# AWS CONFIGURATION
# ==============================================

# AWS region used by the browser-agent-container, Bedrock, S3, DynamoDB.
# Must be a region where Anthropic Claude Sonnet 4.5 is available via
# cross-region inference profiles (e.g., us-west-2, us-east-1).
AWS_DEFAULT_REGION=us-west-2

# ==============================================
# BROWSER AGENT CONFIGURATION (BA_ prefix)
# ==============================================

# Bedrock model ID for the browser agent.
# MUST use the cross-region inference profile prefix (`us.`).
# Change with care — blog reference uses Claude Sonnet 4.5.
BA_BROWSER_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Browser session time-to-live, seconds. Default 3600 (1 hour).
BA_SESSION_TIMEOUT=3600

# Local directory for session/screenshot persistence when
# BA_SESSION_STORE_TYPE=memory. Ignored for s3 / dynamodb backends.
BA_SESSIONS_DIR=sessions

# Maximum number of agent reasoning+action steps per browser session.
# Guards against runaway loops.
BA_MAX_STEPS_PER_SESSION=100

# Grace period (seconds) after a WebSocket disconnect before the
# browser session is torn down. Allows brief reconnects without losing state.
BA_DISCONNECT_GRACE_SECONDS=30

# Human-in-the-loop (HITL) timeout, seconds. If the user doesn't
# respond to a handoff_to_user prompt within this window, it's cancelled.
BA_HITL_TIMEOUT_SECONDS=300

# Pre-signed screenshot URL expiry, minutes. Default 15 — kept short so a
# leaked URL is only replayable for a brief window. Raise it if the UI needs
# longer-lived screenshot links, but treat every increase as a disclosure
# tradeoff (the URL grants unauthenticated read of a session screenshot).
BA_SCREENSHOT_URL_EXPIRY_MINUTES=15

# Session store backend. Allowed: memory | dynamodb | s3.
# Blog production default is `s3` (durable, cheap, IAM-scoped).
# For local development without AWS, `memory` is fine.
BA_SESSION_STORE_TYPE=s3

# S3 bucket name for session persistence when BA_SESSION_STORE_TYPE=s3.
# Leave empty for `memory` backend.
BA_SESSION_STORE_BUCKET=

# Key prefix used inside the S3 bucket / DDB table for session records.
BA_SESSION_STORE_PREFIX=browser-sessions

# ==============================================
# STANDARD CONFIGURATION
# ==============================================

# Python logging level. Allowed: DEBUG | INFO | WARNING | ERROR | CRITICAL.
# Defaults to ERROR so published/deployed builds don't write access tokens or
# page content into application logs. Bump to DEBUG locally when you need the
# full request/tool trace for troubleshooting.
LOG_LEVEL=ERROR
