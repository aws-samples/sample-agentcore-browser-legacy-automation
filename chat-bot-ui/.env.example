# Chat Bot UI — environment template.
# Copy this to `.env` and fill in values for production build.
# `.env` and `.env.dev` are gitignored; `.env.example` is tracked.

# WebSocket URL — full wss:// URL for the gateway.
# Example: wss://your-gateway.example.com
WEBSOCKET_URL=

# OIDC Configuration (IdP-agnostic).
# See root README.md § "Switching identity providers" for the full matrix of
# Cognito / Auth0 / Okta / Entra ID values.
#
# Cognito example:
#   OIDC_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
#   OIDC_CLIENT_ID=<user-pool-client-id>
#   OIDC_AUDIENCE=  (empty — Cognito access tokens use client_id, not aud)
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OIDC_SCOPE=openid profile email
