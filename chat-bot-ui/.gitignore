# See https://help.github.com/ignore-files/ for more about ignoring files.

# Dependencies - node_modules and package manager files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs - webpack and other build tools
build/
dist/
coverage/

# Environment variables - sensitive configuration
.env
.env.*
!.env.example

# IDE and editor files
.idea/
*.swp
*.swo
*.iml

# Terraform
*.tfstate
*.tfstate.*
.terraform/
user-sample.tfvars
terraform.tfvars

# AWS
.aws/

# Operating system files
.DS_Store
Thumbs.db

# Logs and temporary files
logs/
*.log
*.tmp
*.temp
temp
*gz
*local.md
*.local
*.public
*old

# Project specific
# Project specific
tmp/
cert/
backups/
CHECKPOINT.md
server.log
research

# Git - keep .gitkeep files for empty directories
!.gitkeep

# VS Code tasks.json contains deployment-specific values — use tasks.json.example
.vscode/tasks.json
